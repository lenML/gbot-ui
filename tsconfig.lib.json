{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist-lib/types",
    "rootDir": "src",
    "tsBuildInfoFile": "dist-lib/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/components",
    "src/lib",
    "src/library.ts"
  ],
  "exclude": [
    "src/demo",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
